<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The app kit's packages ship inside this repository (vendor/nuget); everything else comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="appkit" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="appkit">
      <package pattern="Endgame.AppKit" />
      <package pattern="Endgame.AppKit.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
