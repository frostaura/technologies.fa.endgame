<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Endgame.AppKit</PackageId>
    <Description>The library every Endgame app is built against: hosting under any address, health, OpenAPI, telemetry, data, and typed clients for the platform's shared services.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Endgame.AppKit.Tests" />
    <!-- AppChecks reads the endpoints UseEndgameApp() captured, as the start-up contract does. -->
    <InternalsVisibleTo Include="Endgame.AppKit.Testing" />
  </ItemGroup>
</Project>
