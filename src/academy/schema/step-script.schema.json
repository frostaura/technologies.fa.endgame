{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frostaura.github.io/technologies.fa.endgame/schema/step-script.schema.json",
  "title": "Endgame Academy step script",
  "description": "What each numbered step of one flow shows beside its text. One file per flow: src/academy/scripts/<FLOW-ID>.json. The TypeScript twin is src/content/scripts.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flow",
    "persona",
    "scenario",
    "start",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "flow": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-\\d{2}$",
      "description": "The flow id; must match the file name."
    },
    "persona": {
      "enum": [
        "owner",
        "admin",
        "builder",
        "viewer",
        "operator",
        "signed-out",
        "end-user",
        "assistant",
        "host-admin",
        "division-admin",
        "invited",
        "first-run",
        "two-organisations"
      ]
    },
    "scenario": {
      "enum": [
        "fresh-install",
        "first-idea",
        "established",
        "researching",
        "verdict-build",
        "verdict-change",
        "building",
        "app-live",
        "low-credits",
        "god-mode",
        "account",
        "two-organisations",
        "app-asleep",
        "app-paused",
        "app-crashed",
        "at-overdraft-limit",
        "s1-app-made-private",
        "s1-app-not-published",
        "s1-app-private",
        "s1-app-public",
        "s1-app-unshared",
        "s1-development-apps",
        "s1-development-sign-in",
        "s1-keys-at-limit",
        "s1-session-check-fails",
        "quiet",
        "hire-pending",
        "employee-memory",
        "employee-released",
        "screening-offline",
        "build-running",
        "s4-hiring",
        "s4-hires-all-decided",
        "s4-hire-manager-gone",
        "s4-contractor-working",
        "s4-contractor-finishes",
        "s4-employee-working",
        "s4-employee-record",
        "s4-employee-team",
        "s4-employee-at-cap",
        "s4-idle-sweep",
        "s4-released-with-memory",
        "s4-memory-to-tidy",
        "s4-credits-at-zero",
        "s4-below-zero",
        "s4-top-ups-waiting",
        "s4-operator-log",
        "s4-operator-log-empty",
        "default",
        "empty-organisation",
        "research-running",
        "research-verdict",
        "verdict-do-not-build",
        "verdict-red-line",
        "build-plan",
        "build-sent-back",
        "build-security-finding",
        "build-published",
        "build-waiting-on-plan",
        "build-failed",
        "app-busy",
        "app-never-measured",
        "budget-spent",
        "manage-tree",
        "ask-unavailable",
        "app-private",
        "app-public",
        "app-shared-empty",
        "app-restore-fails",
        "app-rebuild-fails",
        "app-not-published",
        "app-wake-slow",
        "app-wake-busy",
        "app-unreachable",
        "outage",
        "no-secrets",
        "dashboard-full",
        "app-long-history",
        "wake-failures"
      ]
    },
    "start": {
      "$ref": "#/definitions/route"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "variations": {
      "type": "array",
      "description": "What else can happen: each refusal or branch that matters, played in the live console from its own start, as its own person and world. Shown under \"What else can happen\" on the flow's page.",
      "items": {
        "$ref": "#/definitions/variation"
      }
    }
  },
  "definitions": {
    "route": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9/{}_?=&.-]*$",
      "description": "A console address. {idea}, {run}, {app}, {employee} and {hire} are resolved by the demo inside the scenario."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "testId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "play"
          ],
          "properties": {
            "play": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pause"
          ],
          "properties": {
            "pause": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seek"
          ],
          "properties": {
            "seek": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[a-z]+:[a-z0-9-]+$"
                }
              ]
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "click"
          ],
          "properties": {
            "click": {
              "$ref": "#/definitions/target"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "into",
                "text"
              ],
              "properties": {
                "into": {
                  "$ref": "#/definitions/target"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select"
          ],
          "properties": {
            "select": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "into",
                "value"
              ],
              "properties": {
                "into": {
                  "$ref": "#/definitions/target"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "press"
          ],
          "properties": {
            "press": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait"
          ],
          "properties": {
            "wait": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clock"
          ],
          "properties": {
            "clock": {
              "$ref": "#/definitions/clock"
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "step",
        "kind"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "demo",
            "terminal",
            "request",
            "email",
            "image",
            "code"
          ]
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "demo"
            },
            "goto": {
              "$ref": "#/definitions/route"
            },
            "persona": {
              "$ref": "#/properties/persona",
              "description": "From this step on, someone else is signed in to the same world (the operator acts, then the Owner reads what was logged). Needs a goto."
            },
            "highlight": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "testId": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "$ref": "#/definitions/note"
                }
              }
            },
            "act": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/action"
              }
            },
            "clock": {
              "$ref": "#/definitions/clock"
            },
            "note": {
              "$ref": "#/definitions/note"
            },
            "shot": {
              "$ref": "#/definitions/shot"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "command",
            "output"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "terminal"
            },
            "cwd": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "$ref": "#/definitions/note"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "method",
            "path",
            "response"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "request"
            },
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {},
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "body": {}
              }
            },
            "note": {
              "$ref": "#/definitions/note"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "subject",
            "body"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "email"
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "note": {
              "$ref": "#/definitions/note"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "file",
            "alt"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "image"
            },
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp|svg)$"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "$ref": "#/definitions/note"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "language",
            "code"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "code"
            },
            "language": {
              "enum": [
                "csharp",
                "typescript",
                "tsx",
                "javascript",
                "json",
                "http",
                "bash",
                "sql",
                "yaml",
                "text"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "$ref": "#/definitions/note"
            }
          }
        }
      ]
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "alt"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp|svg)$",
          "description": "A file under src/academy/public/shots/."
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A captured image of this step, shown in print and whenever the live console cannot load."
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "persona",
        "scenario",
        "start",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "The branch in a few words, as the learner picks it."
        },
        "persona": {
          "$ref": "#/properties/persona"
        },
        "scenario": {
          "$ref": "#/properties/scenario"
        },
        "start": {
          "$ref": "#/definitions/route"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "Numbered 1, 2, … within the variation; each step's note says what it shows."
        }
      }
    }
  }
}
