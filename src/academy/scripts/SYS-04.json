{
  "$schema": "../schema/step-script.schema.json",
  "flow": "SYS-04",
  "persona": "owner",
  "scenario": "status-unreachable",
  "start": "/system",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "text": "Endgame could not be asked how it is",
        "note": "The first check could not reach the control plane: nothing below is known."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Try again"
          }
        }
      ],
      "highlight": {
        "selector": "section[aria-label='Whether Endgame is working']",
        "note": "Try again checks, and once the check answers, the page says how Endgame is."
      }
    }
  ],
  "variations": [
    {
      "title": "A later check fails",
      "persona": "owner",
      "scenario": "status-refresh-fails",
      "start": "/system",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "act": [
            {
              "click": {
                "text": "Technical"
              }
            },
            {
              "wait": {
                "selector": "ul[aria-label='Services']"
              }
            },
            {
              "click": {
                "text": "Check again"
              }
            }
          ],
          "highlight": {
            "selector": "[data-state='stale']",
            "note": "The last good results stay, marked as from the last check that succeeded."
          }
        }
      ]
    },
    {
      "title": "The control plane reports no services",
      "persona": "owner",
      "scenario": "status-no-services",
      "start": "/system",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "act": [
            {
              "click": {
                "text": "Technical"
              }
            }
          ],
          "highlight": {
            "text": "That is a fault, not a quiet system.",
            "note": "Zero services is a fault, said plainly, never a healthy system."
          }
        }
      ]
    }
  ]
}
