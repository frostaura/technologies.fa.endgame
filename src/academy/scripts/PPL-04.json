{
  "$schema": "../schema/step-script.schema.json",
  "flow": "PPL-04",
  "persona": "admin",
  "scenario": "established",
  "start": "/people",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "type": {
            "into": {
              "text": "E-mail address"
            },
            "text": "priya@northwind.example"
          }
        },
        {
          "select": {
            "into": {
              "text": "Role"
            },
            "value": "Builder"
          }
        },
        {
          "select": {
            "into": {
              "text": "Where"
            },
            "value": "Learning"
          }
        }
      ],
      "highlight": {
        "text": "Invite someone",
        "note": "Priya already signs in with a passkey: she is a Viewer of the whole organisation."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Invite"
          }
        }
      ],
      "highlight": {
        "text": "Priya Shah",
        "note": "The server grants the role and issues no code."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "act": [
        {
          "wait": 1500
        }
      ],
      "highlight": {
        "text": "already has a passkey",
        "note": "She holds Builder in Learning now and can sign in straight away."
      }
    }
  ]
}
