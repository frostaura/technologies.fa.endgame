{
  "$schema": "../schema/step-script.schema.json",
  "flow": "SHL-02",
  "persona": "owner",
  "scenario": "established",
  "start": "/system",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "text": "Is Endgame working?",
        "note": "In normal mode the services are not named: the page says in plain words whether Endgame is working."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Switch to technical mode"
          }
        },
        {
          "wait": 1200
        }
      ],
      "highlight": {
        "selector": "[role=group][aria-label='Mode']",
        "note": "Technical mode is on, and the status itself shows."
      }
    }
  ]
}
