{
  "$schema": "../schema/step-script.schema.json",
  "flow": "VERD-03",
  "persona": "viewer",
  "scenario": "verdict-change",
  "start": "/ideas/{idea}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "text": "Verdict ·",
        "note": "The verdict: its tag, the headline and two sentences of the summary."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "highlight": {
        "text": "No red line is crossed",
        "note": "A red-line alert would sit beside the headline when one is breached; here none is."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "highlight": {
        "text": "The case against, argued first",
        "note": "The case against the idea, argued first."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "text": "Who already does this",
        "note": "Who already does it; then “What gap is left” and “Who would want it”."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "highlight": {
        "text": "What to change",
        "note": "On a “change” verdict, research’s change."
      }
    },
    {
      "step": 6,
      "kind": "demo",
      "highlight": {
        "text": "What would change the verdict",
        "note": "What would change the verdict."
      }
    },
    {
      "step": 7,
      "kind": "demo",
      "highlight": {
        "text": "No red line is crossed",
        "note": "The red-line screen, with its reasoning."
      }
    },
    {
      "step": 8,
      "kind": "demo",
      "highlight": {
        "text": "Build it with this change",
        "note": "Then the decisions (a Viewer sees them; only a Builder may take them)."
      }
    }
  ]
}
