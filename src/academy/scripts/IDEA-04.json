{
  "$schema": "../schema/step-script.schema.json",
  "flow": "IDEA-04",
  "persona": "owner",
  "scenario": "s3-waiting-for-budget",
  "start": "/runs/{run}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "clock": {
        "seek": 3000
      },
      "highlight": {
        "text": "Step by step",
        "note": "The research was started as usual: nothing on the start screen checks the balance."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "wait": {
            "text": "Waiting for budget"
          }
        }
      ],
      "highlight": {
        "text": "Endgame · Waiting for budget",
        "note": "Learning has 5 credits left this month, less than the 12 estimated: the run pauses before any work."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Resume"
          }
        },
        {
          "wait": {
            "text": "Resumed"
          }
        }
      ],
      "highlight": {
        "text": "Resumed",
        "note": "After a top-up or a budget raise, “Resume” picks it up again."
      }
    }
  ],
  "variations": [
    {
      "title": "In checkpoints mode the budget still waits",
      "persona": "owner",
      "scenario": "s3-checkpoints-waiting-for-budget",
      "start": "/runs/{run}",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "clock": {
            "seek": 3000
          },
          "act": [
            {
              "wait": {
                "text": "Waiting for budget"
              }
            }
          ],
          "highlight": {
            "text": "Endgame · Waiting for budget",
            "note": "Learning is in checkpoints mode with 5 credits left: the budget is the limit that is always on, so the run pauses before any work."
          }
        }
      ]
    }
  ]
}
