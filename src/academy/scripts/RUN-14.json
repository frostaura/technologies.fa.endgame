{
  "$schema": "../schema/step-script.schema.json",
  "flow": "RUN-14",
  "persona": "viewer",
  "scenario": "build-sent-back",
  "start": "/runs/{run}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "testId": "part-tasks",
        "note": "Each part of the plan lists its tasks — its build and its checks — and who took each on."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "clock": {
        "seek": "build:security-review"
      },
      "act": [
        {
          "wait": {
            "text": "Checked and working"
          }
        }
      ],
      "highlight": {
        "text": "What each found",
        "note": "Tasks move to “done” as the build goes on; what each found opens under the part."
      }
    }
  ]
}
