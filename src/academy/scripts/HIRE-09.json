{
  "$schema": "../schema/step-script.schema.json",
  "flow": "HIRE-09",
  "persona": "owner",
  "scenario": "quiet",
  "start": "/hires?scope=northwind/technologies",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "wait": 1000
        },
        {
          "click": {
            "text": "Ask for a hire"
          }
        }
      ],
      "highlight": {
        "text": "A hire for Technologies",
        "note": "Draft the job yourself; it becomes a proposal like any other."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "type": {
            "into": {
              "text": "Name"
            },
            "text": "Noor"
          }
        },
        {
          "type": {
            "into": {
              "text": "Role"
            },
            "text": "Support engineer"
          }
        },
        {
          "type": {
            "into": {
              "text": "Mandate"
            },
            "text": "Answer members' questions about bookings and playing minutes, and pass anything broken to Kasper."
          }
        },
        {
          "type": {
            "into": {
              "text": "What it should cost a month"
            },
            "text": "60"
          }
        },
        {
          "type": {
            "into": {
              "text": "Why this hire"
            },
            "text": "Members write in about bookings every evening; someone who knows the app answers faster."
          }
        }
      ],
      "highlight": {
        "text": "Ask for this hire",
        "note": "The job, what it should cost a month, and why."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Ask for this hire"
          }
        },
        {
          "wait": 1500
        }
      ],
      "highlight": {
        "text": "You asked for this hire",
        "note": "You land on the proposal: 60 credits fits the room left, so auto-mode hired Noor at once."
      }
    }
  ],
  "variations": [
    {
      "title": "More than the room left: it waits for you",
      "persona": "owner",
      "scenario": "quiet",
      "start": "/hires?scope=northwind/technologies",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "act": [
            {
              "wait": 1000
            },
            {
              "click": {
                "text": "Ask for a hire"
              }
            },
            {
              "type": {
                "into": {
                  "text": "Name"
                },
                "text": "Noor"
              }
            },
            {
              "type": {
                "into": {
                  "text": "Role"
                },
                "text": "Support engineer"
              }
            },
            {
              "type": {
                "into": {
                  "text": "What it should cost a month"
                },
                "text": "200"
              }
            },
            {
              "type": {
                "into": {
                  "text": "Why this hire"
                },
                "text": "Members write in about bookings every evening."
              }
            }
          ],
          "highlight": {
            "text": "Ask for this hire",
            "note": "The same request, at 200 credits a month."
          }
        },
        {
          "step": 2,
          "kind": "demo",
          "act": [
            {
              "click": {
                "text": "Ask for this hire"
              }
            },
            {
              "wait": 1500
            }
          ],
          "highlight": {
            "text": "More than the budget has room for",
            "note": "Over the room left in Technologies, so it waits as “Hire proposed” for a person to decide."
          }
        }
      ]
    },
    {
      "title": "Nothing is sent without a name and a role",
      "persona": "owner",
      "scenario": "quiet",
      "start": "/hires?scope=northwind/technologies",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "act": [
            {
              "wait": 1000
            },
            {
              "click": {
                "text": "Ask for a hire"
              }
            },
            {
              "click": {
                "text": "Ask for this hire"
              }
            }
          ],
          "highlight": {
            "text": "It needs a name and a role.",
            "note": "Then “Say what it should cost a month, in credits.” and “Say why the hire is needed.”"
          }
        }
      ]
    },
    {
      "title": "Below Admin there is no button",
      "persona": "builder",
      "scenario": "quiet",
      "start": "/hires?scope=northwind/technologies",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "highlight": {
            "text": "Hiring for Technologies",
            "note": "Lena is a Builder: she reads every proposal, and “Ask for a hire” is not shown."
          }
        }
      ]
    }
  ]
}
