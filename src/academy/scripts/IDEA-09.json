{
  "$schema": "../schema/step-script.schema.json",
  "flow": "IDEA-09",
  "persona": "owner",
  "scenario": "s3-suggestions",
  "start": "/suggestions?scope=northwind",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "text": "Set it aside",
        "note": "No confirmation: it leaves the list at once."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Set it aside"
          }
        }
      ],
      "highlight": {
        "selector": "ul[aria-label='Suggested ideas']",
        "note": "Gone from the open list at once…"
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Taken or set aside (3)"
          }
        }
      ],
      "highlight": {
        "text": "Taken or set aside (3)",
        "note": "…and kept on record under “Taken or set aside”, its count one higher."
      }
    }
  ]
}
