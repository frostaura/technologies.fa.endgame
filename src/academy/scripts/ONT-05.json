{
  "$schema": "../schema/step-script.schema.json",
  "flow": "ONT-05",
  "persona": "owner",
  "scenario": "quiet",
  "start": "/",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Who works on what"
          }
        },
        {
          "click": {
            "selector": "[aria-label='Who works on what']:not(button) a[href*='employees']"
          }
        }
      ],
      "highlight": {
        "selector": "main h1",
        "note": "An employee or contractor in a graph opens their page."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "goto": "/",
      "act": [
        {
          "click": {
            "text": "How data flows"
          }
        },
        {
          "click": {
            "selector": "[aria-label='How data flows']:not(button) a[href*='apps']"
          }
        }
      ],
      "highlight": {
        "selector": "main h1",
        "note": "An app opens the app's page. Nothing else in the graph is a link."
      }
    }
  ]
}
