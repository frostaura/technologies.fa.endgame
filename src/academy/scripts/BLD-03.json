{
  "$schema": "../schema/step-script.schema.json",
  "flow": "BLD-03",
  "persona": "viewer",
  "scenario": "building",
  "start": "/runs/{run}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "wait": {
            "text": "Agreed"
          }
        }
      ],
      "highlight": {
        "text": "The plan",
        "note": "The plan is a contract: proposed, then agreed, with how many parts are done."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "highlight": {
        "text": "A private reading list for the supper club",
        "note": "Its summary."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "highlight": {
        "text": "What you asked for",
        "note": "What you asked for, in your words."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "text": "Parts of the plan",
        "note": "Each part, with whether it passed its check."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "highlight": {
        "text": "Left out, on purpose",
        "note": "Anything left out, with the reason."
      }
    },
    {
      "step": 6,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Technical"
          }
        },
        {
          "wait": {
            "text": "Check:"
          }
        }
      ],
      "highlight": {
        "text": "Check:",
        "note": "Files, tests and the check behind each part are technical detail: technical mode shows them."
      }
    },
    {
      "step": 7,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Normal"
          }
        },
        {
          "wait": {
            "text": "The builder · The plan"
          }
        }
      ],
      "highlight": {
        "text": "The builder · The plan",
        "note": "Back in normal mode, the builder says the plan in one message."
      }
    }
  ]
}
