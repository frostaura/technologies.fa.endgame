{
  "$schema": "../schema/step-script.schema.json",
  "flow": "TALK-15",
  "persona": "owner",
  "scenario": "budget-spent",
  "start": "/",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Technologies"
          }
        },
        {
          "wait": {
            "text": "Talking to Technologies"
          }
        }
      ],
      "highlight": {
        "text": "A message here costs at most",
        "note": "The cost before sending."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "wait": {
            "text": "A message here costs at most"
          }
        },
        {
          "type": {
            "into": {
              "text": "Message Technologies"
            },
            "text": "What is over budget?"
          }
        },
        {
          "clock": {
            "pause": true
          }
        },
        {
          "click": {
            "text": "Send"
          }
        },
        {
          "wait": {
            "text": "Working on it"
          }
        }
      ],
      "highlight": {
        "text": "Working on it",
        "note": "Sending still succeeds: the turn is queued."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "clock": {
        "play": true
      },
      "act": [
        {
          "clock": {
            "seek": 3000
          }
        },
        {
          "wait": {
            "text": "The credit budget ran out before a reply"
          }
        }
      ],
      "highlight": {
        "text": "The credit budget ran out before a reply could be written",
        "note": "Technologies has spent its budget: a notice instead of a reply, with “See credits”."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "text": "See credits",
        "note": "It is kept in the conversation’s history."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "highlight": {
        "none": "No world here fails for a reason of its own; the stop notice shown when no reply comes at all is played under “The reply never came”, below."
      },
      "note": "Any other failure reads “I could not finish answering that. Please ask again.”"
    }
  ],
  "variations": [
    {
      "title": "The reply never came",
      "persona": "owner",
      "scenario": "talk-reply-interrupted",
      "start": "/",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "highlight": {
            "text": "The reply was interrupted.",
            "note": "The work stopped with no reply: the dock says so, that nothing more was charged, and offers “Try again”."
          }
        }
      ]
    }
  ]
}
