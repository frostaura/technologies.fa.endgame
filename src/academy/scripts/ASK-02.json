{
  "$schema": "../schema/step-script.schema.json",
  "flow": "ASK-02",
  "persona": "builder",
  "scenario": "app-busy",
  "start": "/apps/{app}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "type": {
            "into": {
              "text": "Which days are busiest?"
            },
            "text": "Which days are busiest?"
          }
        },
        {
          "click": {
            "selector": "form:has(input[placeholder=\"Which days are busiest?\"]) button[type=submit]"
          }
        },
        {
          "click": {
            "selector": "div[role=\"status\"] > button"
          }
        }
      ],
      "highlight": {
        "selector": "section[aria-label=\"Asking about this app\"]",
        "region": true,
        "note": "Asking: a model writes one read-only query."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "highlight": {
        "text": "Saturday is the busiest day",
        "note": "The query was guarded and run on this app's own records, then a second call put the rows into words. A failed query is repaired once, free."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "highlight": {
        "text": "Cost 0.13 credits of at most 0.42 credits",
        "note": "Charged at the real cost, against the most it could have cost; then the answer and its chart, here bars."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "selector": "section[aria-label=\"Asking about this app\"] [role=\"img\"]",
        "note": "A chart of up to 24 bars. Had there been more rows than shown, a line under it would say so."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "highlight": {
        "selector": "a[href='/credits']",
        "note": "The balance is read again: it fell by what the question cost."
      }
    }
  ],
