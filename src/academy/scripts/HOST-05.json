{
  "$schema": "../schema/step-script.schema.json",
  "flow": "HOST-05",
  "persona": "admin",
  "scenario": "app-crashed",
  "start": "/__app/{app}/path/",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "text": "Something went wrong inside it.",
        "note": "“This app has stopped for a moment” (503, Retry-After 15): no wake is tried for 15 seconds."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "goto": "/notifications",
      "highlight": {
        "text": "Shift Rota stopped working",
        "note": "Dock reported it failed: a person is told, at most once a minute per app."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "goto": "/apps/{app}",
      "highlight": {
        "text": "Down",
        "note": "Health reads Down: it stopped working and needs attention."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "text": "Bring back",
        "note": "Its last good version can be brought back (VER-02), or it can be rebuilt (APP-15)."
      }
    }
  ]
}
