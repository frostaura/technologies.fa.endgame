{
  "$schema": "../schema/step-script.schema.json",
  "flow": "RUN-07",
  "persona": "owner",
  "scenario": "build-waiting-on-plan",
  "start": "/runs/{run}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "act": [
        {
          "wait": {
            "text": "Accept this plan?"
          }
        }
      ],
      "highlight": {
        "text": "Needs you",
        "note": "Waiting for your approval: what approving does, in plain words."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "act": [
        {
          "type": {
            "into": {
              "text": "Add a note (optional)"
            },
            "text": "Keep the list to one screen on a phone."
          }
        }
      ],
      "highlight": {
        "text": "Add a note (optional)",
        "note": "A note goes back to the work with your answer."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "highlight": {
        "text": "Declining stops this work.",
        "note": "The card says truthfully what a decline does: for the plan, it stops the work."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "act": [
        {
          "click": {
            "text": "Approve"
          }
        },
        {
          "wait": {
            "text": "Agreed"
          }
        }
      ],
      "highlight": {
        "text": "Agreed",
        "note": "Approved: the plan is agreed and the work carries on."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "highlight": {
        "text": "You answered",
        "note": "The answer is logged, with the note given back to the work."
      }
    }
  ],
  "variations": [
    {
      "title": "Decline a step an “Asks you first” rule stopped",
      "persona": "owner",
      "scenario": "s3-stage-rules",
      "start": "/runs/{run}",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "clock": {
            "seek": "build:part-3"
          },
          "act": [
            {
              "clock": {
                "seek": 20000
              }
            },
            {
              "wait": {
                "text": "Let the agent change part of the app?"
              }
            }
          ],
          "highlight": {
            "text": "Let the agent change part of the app?",
            "note": "A stage rule asks before the app’s description changes."
          }
        },
        {
          "step": 2,
          "kind": "demo",
          "act": [
            {
              "click": {
                "text": "Decline"
              }
            },
            {
              "clock": {
                "seek": 20000
              }
            },
            {
              "wait": {
                "text": "You declined: change part of the app"
              }
            }
          ],
          "highlight": {
            "text": "You declined: change part of the app",
            "note": "Declined: only that step is skipped, and the work goes on without it."
          }
        }
      ]
    },
    {
      "title": "The work ends before anyone answers",
      "persona": "owner",
      "scenario": "build-waiting-on-plan",
      "start": "/runs/{run}",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "act": [
            {
              "wait": {
                "text": "Accept this plan?"
              }
            },
            {
              "click": {
                "text": "Cancel"
              }
            },
            {
              "click": {
                "text": "Yes, cancel it"
              }
            },
            {
              "wait": {
                "text": "The work ended before this was answered."
              }
            }
          ],
          "highlight": {
            "text": "The work ended before this was answered.",
            "note": "Cancelled while it waited: the question closes with the work, and nothing is left to approve or decline."
          }
        },
        {
          "step": 2,
          "kind": "demo",
          "act": [
            {
              "click": {
                "selector": "button[aria-label^=\"Notifications\"]"
              }
            },
            {
              "wait": {
                "text": "the work ended before it was answered"
              }
            }
          ],
          "highlight": {
            "text": "the work ended before it was answered",
            "note": "Its notice says it is no longer waiting, marked Closed — never as answered."
          }
        }
      ]
    }
  ]
}
