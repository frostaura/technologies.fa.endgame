{
  "$schema": "../schema/step-script.schema.json",
  "flow": "NOTE-01",
  "persona": "owner",
  "scenario": "quiet",
  "start": "/",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "highlight": {
        "selector": "button[aria-label^='Notifications'], a[aria-label^='Alerts']",
        "note": "The bell counts the unread notices: a coral badge, and a label read out as “Notifications, 7 unread”. It asks again every 30 seconds."
      }
    }
  ],
  "variations": [
    {
      "title": "A Builder's bell counts nothing",
      "persona": "builder",
      "scenario": "quiet",
      "start": "/",
      "steps": [
        {
          "step": 1,
          "kind": "demo",
          "highlight": {
            "selector": "button[aria-label^='Notifications'], a[aria-label^='Alerts']",
            "note": "Lena is a Builder: notices go to Owners and Admins, so her bell shows no badge."
          }
        }
      ]
    }
  ]
}
