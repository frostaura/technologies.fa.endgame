{
  "$schema": "../schema/step-script.schema.json",
  "flow": "OPS-19",
  "persona": "host-admin",
  "scenario": "established",
  "start": "/",
  "steps": [
    {
      "step": 1,
      "kind": "terminal",
      "command": "make ops-reserved-hosts OPS_COMPOSE=\"docker compose -f docker-compose.prod.yml\"",
      "output": [
        "docker compose -f docker-compose.prod.yml exec -T ops /app/Endgame.Ops reserved-hosts",
        "{",
        "  \"zone\": \"frostaura.net\",",
        "  \"complete\": true,",
        "  \"source\": \"cloudflare\",",
        "  \"readAt\": \"2026-11-25T10:31:07.4410192+00:00\",",
        "  \"labels\": [",
        "    \"admin\",",
        "    \"api\",",
        "    \"endgame\",",
        "    \"ftp\",",
        "    \"imap\",",
        "    \"mail\",",
        "    \"mx\",",
        "    \"ns1\",",
        "    \"ns2\",",
        "    \"pop\",",
        "    \"portainer\",",
        "    \"smtp\",",
        "    \"status\",",
        "    \"www\"",
        "  ],",
        "  \"reserved\": [",
        "    {",
        "      \"label\": \"admin\",",
        "      \"reason\": \"always reserved\",",
        "      \"records\": []",
        "    },",
        "    {",
        "      \"label\": \"endgame\",",
        "      \"reason\": \"the console host\",",
        "      \"records\": []",
        "    },",
        "    {",
        "      \"label\": \"portainer\",",
        "      \"reason\": \"an existing DNS record\",",
        "      \"records\": [",
        "        \"CNAME portainer.frostaura.net\"",
        "      ]",
        "    },",
        "    {",
        "      \"label\": \"www\",",
        "      \"reason\": \"always reserved\",",
        "      \"records\": [",
        "        \"A www.frostaura.net\"",
        "      ]",
        "    },"
      ],
      "note": "Production with a token: the fixed labels, the console host's label, and every label the zone's own records use. Only four of the reserved entries are shown, in their order; the list closes after www. The records and time are illustrative."
    }
  ],
  "variations": [
    {
      "title": "No Cloudflare token: the list is incomplete",
      "persona": "host-admin",
      "scenario": "established",
      "start": "/",
      "steps": [
        {
          "step": 1,
          "kind": "terminal",
          "command": "make ops-reserved-hosts OPS_COMPOSE=\"docker compose -f docker-compose.prod.yml\"",
          "output": [
            "docker compose -f docker-compose.prod.yml exec -T ops /app/Endgame.Ops reserved-hosts",
            "{",
            "  \"zone\": \"frostaura.net\",",
            "  \"complete\": false,",
            "  \"source\": \"static\",",
            "  \"readAt\": null,",
            "  \"labels\": [",
            "    \"admin\",",
            "    \"api\",",
            "    \"endgame\",",
            "    \"ftp\",",
            "    \"imap\",",
            "    \"mail\",",
            "    \"mx\",",
            "    \"ns1\",",
            "    \"ns2\",",
            "    \"pop\",",
            "    \"smtp\",",
            "    \"status\",",
            "    \"www\"",
            "  ],",
            "  \"reserved\": [",
            "    {",
            "      \"label\": \"admin\",",
            "      \"reason\": \"always reserved\",",
            "      \"records\": []",
            "    },",
            "  ],",
            "  \"reason\": \"No Cloudflare API token is configured: the zone\\u0027s existing records were not read, so only the fixed reservations are listed.\"",
            "}"
          ],
          "note": "complete is false, so the control plane refuses new organisation names until the list is complete. Only the first reserved entry is shown; every label has one. ' is written as \\u0027."
        }
      ]
    }
  ]
}
