{
  "$schema": "../schema/step-script.schema.json",
  "flow": "RUN-01",
  "persona": "viewer",
  "scenario": "researching",
  "start": "/runs/{run}",
  "steps": [
    {
      "step": 1,
      "kind": "demo",
      "clock": {
        "pause": true
      },
      "highlight": {
        "text": "Started",
        "note": "The work opens on its title, its status and when it started."
      }
    },
    {
      "step": 2,
      "kind": "demo",
      "clock": {
        "play": true
      },
      "highlight": {
        "text": "Live",
        "note": "The stream is live: new steps arrive without a reload."
      }
    },
    {
      "step": 3,
      "kind": "demo",
      "act": [
        {
          "wait": {
            "text": "Research started"
          }
        }
      ],
      "highlight": {
        "text": "Step by step",
        "note": "Steps arrive as they happen."
      }
    },
    {
      "step": 4,
      "kind": "demo",
      "highlight": {
        "text": "Research · Research started",
        "note": "Every step is one row: its mark, who did what, what it cost and when."
      }
    },
    {
      "step": 5,
      "kind": "demo",
      "clock": {
        "seek": "research:finished"
      },
      "act": [
        {
          "wait": {
            "text": "Finished"
          }
        }
      ],
      "highlight": {
        "text": "Finished",
        "note": "When it finishes the stream closes."
      }
    },
    {
      "step": 6,
      "kind": "demo",
      "highlight": {
        "text": "Where the credits go",
        "note": "From 1280 wide, “Tasks” and “Where the credits go” stand beside the page."
      }
    }
  ]
}
