{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "control-plane",
        "Order": 10,
        "Match": { "Path": "/api/{**rest}" }
      },
      "mcp": {
        "ClusterId": "control-plane",
        "Order": 11,
        "Match": {
          "Path": "/mcp"
        }
      },
      "mcp-apps": {
        "ClusterId": "control-plane",
        "Order": 12,
        "Match": {
          "Path": "/mcp/{**rest}"
        }
      },
      "console": {
        "ClusterId": "console",
        "Order": 100,
        "Match": { "Path": "{**rest}" }
      }
    },
    "Clusters": {
      "control-plane": {
        "Destinations": { "primary": { "Address": "http://control-plane:8080/" } }
      },
      "console": {
        "Destinations": { "primary": { "Address": "http://console:8080/" } }
      }
    }
  }
}
