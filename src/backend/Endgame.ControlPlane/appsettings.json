{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Status": {
    "ProbeTimeoutMs": 2000,
    "Services": [
      { "Key": "control-plane", "Name": "Control plane", "HealthUrl": "http://127.0.0.1:8080/health", "Order": 10 },
      { "Key": "edge", "Name": "Edge", "HealthUrl": "http://edge:8080/health", "Order": 20 },
      { "Key": "runner", "Name": "Runner", "HealthUrl": "http://runner:8080/health", "Order": 30 },
      { "Key": "dock", "Name": "Dock", "HealthUrl": "http://dock:8080/health", "Order": 40 },
      { "Key": "console", "Name": "Console", "HealthUrl": "http://console:8080/health", "Order": 60 }
    ]
  }
}
