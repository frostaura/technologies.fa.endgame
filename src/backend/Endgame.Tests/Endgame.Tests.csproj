<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Deliberately NOT Dock: a test project that referenced it would carry the Docker client too. -->
    <ProjectReference Include="../Endgame.Domain/Endgame.Domain.csproj" />
    <ProjectReference Include="../Endgame.Application/Endgame.Application.csproj" />
    <ProjectReference Include="../Endgame.Infrastructure/Endgame.Infrastructure.csproj" />
    <ProjectReference Include="../Endgame.ControlPlane/Endgame.ControlPlane.csproj" />
    <ProjectReference Include="../Endgame.Edge/Endgame.Edge.csproj" />
    <ProjectReference Include="../Endgame.Hosting.Contracts/Endgame.Hosting.Contracts.csproj" />
    <ProjectReference Include="../Endgame.Harness/Endgame.Harness.csproj" />
    <ProjectReference Include="../Endgame.Runner/Endgame.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Dock's pure policy, compiled in by file rather than by project reference: a reference to Dock
      would carry the Docker client into the tests (ArchitectureTests). These files use neither.
    -->
    <Compile Include="../Endgame.Dock/Policy/*.cs" Link="Hosting/DockPolicy/%(Filename)%(Extension)" />
    <Compile Include="../Endgame.Dock/Repositories/FilePaging.cs" Link="Hosting/DockPolicy/FilePaging.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app the hosting integration tests build inside a container: never compiled here. -->
    <Compile Remove="Hosting/Fixtures/**" />
    <Content Remove="Hosting/Fixtures/**" />
    <None Remove="Hosting/Fixtures/**" />
  </ItemGroup>
  <!--
    Every referenced service ships an appsettings.json and all land in this one output directory, so which
    survives depends on copy order (Edge's did, failing RoutingTableTests). The control plane's is the one
    its tests read: copy it last.
  -->
  <Target Name="UseTheControlPlanesSettings" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="../Endgame.ControlPlane/appsettings.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
