{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runner": {
    "ControlPlaneUrl": "http://control-plane:8080",
    "DockUrl": "http://dock:8080",
    "Concurrency": 2,
    "ConversationConcurrency": 2,
    "LeaseSeconds": 90,
    "PollSeconds": 2,
    "ShutdownGraceSeconds": 20,
    "BuildTiers": [
      "build",
      "build-t1",
      "build-t2",
      "build-t3"
    ],
    "MaxRepairRounds": 3,
    "ResearchContractors": 3
  }
}
