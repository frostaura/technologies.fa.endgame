# The environment `make up` reads. Key names only: every key below has a development default in
# docker-compose.yml, so this file works as it is. Copy it to .env (untracked) and set what you
# need there. Production (docker-compose.prod.yml) requires the secrets marked [prod] and refuses
# to start without them; it never reads a development default.

# PostgreSQL — the platform's own database. [prod: POSTGRES_PASSWORD]
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Host port for host-side tools (dotnet ef, psql). Bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=

# The edge is the single door; the only service published besides Postgres and the mail view.
EDGE_HOST_PORT=
# The mail catcher's web view and API (development only), on loopback.
MAIL_UI_HOST_PORT=

# The token every internal API call between services carries (ARCH-004). [prod: 32+ random characters]
ENDGAME_SERVICE_TOKEN=
# The model gateway's key. Only the control plane is given it. [prod]
OPENROUTER_API_KEY=
# Seals every secret and derives app tokens: 32 random bytes as hex or base64. [prod]
ENDGAME_VAULT_MASTER_KEY=
# God mode: comma-separated e-mail addresses, an explicit list. [prod]
ENDGAME_OPERATORS=
# Derives every app's database name and password. Changing it orphans existing app databases. [prod: 32+ random characters]
DOCK_SECRET_KEY=

# The control plane's environment (default Development) and the development sign-in (default
# true). Development only: production pins Production and false.
ENDGAME_CONTROL_PLANE_ENVIRONMENT=
ENDGAME_DEV_LOGIN=

# Memory every awake app together may use, measured by real use (ARCH-005).
DOCK_APP_MEMORY_BUDGET_MB=
# The private range Dock cuts every app's /28 from; a second stack on the same engine needs its own.
DOCK_SUBNET_POOL=
# How often Dock and the edge report hosting usage to the control plane, in seconds.
ENDGAME_USAGE_REPORT_SECONDS=

# Dock is the only service given the Docker socket. Inside Docker Desktop's VM the socket is
# root:root 0660, so the non-root Dock process joins the socket's group, which is 0 there.
# On a Linux host set this to the gid of /var/run/docker.sock (`stat -c %g /var/run/docker.sock`).
DOCKER_SOCKET_GID=

# A second stack on the same engine: set COMPOSE_PROJECT_NAME in the shell (not here), with its own
# host ports and DOCK_SUBNET_POOL — see the header of docker-compose.yml.
