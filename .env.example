# Local development defaults for `make up`. Copy to .env (untracked) and change what you need.
# Key names only are ever shared; values stay in .env locally and in the stack's environment in
# production.

# PostgreSQL — the platform's own database.
POSTGRES_USER=endgame
POSTGRES_DB=endgame
POSTGRES_PASSWORD=endgame_dev_password
# Host port for host-side tools (dotnet ef, psql). Bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5446

# The edge is the single door; the only service published besides Postgres.
EDGE_HOST_PORT=8095

# The token every internal API call between services carries (ARCH-004). Development value only:
# production sets its own, 32+ random characters.
ENDGAME_SERVICE_TOKEN=endgame_dev_service_token_change_me

# Derives every app's database name and password. Changing it orphans existing app databases.
# Development value only: production sets its own, 32+ random characters.
DOCK_SECRET_KEY=endgame_dev_dock_secret_key_change_me_now

# Memory every awake app together may use, measured by real use (ARCH-005).
DOCK_APP_MEMORY_BUDGET_MB=4096

# Dock is the only service given the Docker socket. Inside Docker Desktop's VM the socket is
# root:root 0660, so the non-root Dock process joins the socket's group, which is 0 there.
# On a Linux host set this to the gid of /var/run/docker.sock (`stat -c %g /var/run/docker.sock`).
DOCKER_SOCKET_GID=0

ASPNETCORE_ENVIRONMENT=Production
