# The production stack's environment (docker-compose.prod.yml). Paste this into the Portainer
# stack's "Environment variables" (advanced mode) and fill it in. Key names only: no value here is
# real. What each one does, and how to make it, is in docs/architecture/ARCH-008.
#
# REQUIRED — the stack refuses to start without every one of these seven.

# The platform database's password. Any long random string: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# What every call between Endgame's own services carries. `openssl rand -hex 32`.
ENDGAME_SERVICE_TOKEN=
# Derives every app's database name and password. `openssl rand -hex 32`.
# NEVER CHANGE IT once apps exist: their databases would be orphaned.
DOCK_SECRET_KEY=
# The OpenRouter key. Only the control plane is given it; every model call is paid from it.
OPENROUTER_API_KEY=
# Seals every secret in the vault: 32 random bytes, `openssl rand -hex 32`.
# NEVER CHANGE IT: every sealed secret becomes unreadable. Keep a copy off this machine.
ENDGAME_VAULT_MASTER_KEY=
# God mode: the e-mail addresses that are operators, comma-separated. An explicit list.
ENDGAME_OPERATORS=
# Seals every backup archive: `openssl rand -hex 32`. Keep a copy OFF this machine — no archive
# opens without it.
ENDGAME_BACKUP_KEY=

# WHERE IT LIVES — defaults shown; set only what differs.

# The Portainer stack's name. Dock finds its neighbours as <name>-edge-1 and so on.
ENDGAME_STACK_NAME=endgame
# The one port published to the host: the gateway. The tunnel is pointed at it.
ENDGAME_GATEWAY_PORT=8095
# The console's host, and the zone organisation subdomains live under.
ENDGAME_CONSOLE_HOST=endgame.frostaura.net
ENDGAME_ZONE=frostaura.net
# Which release runs: an immutable sha-<commit> tag from CI. `latest` follows main.
ENDGAME_IMAGE_TAG=latest
# The Docker Hub namespace the images are pulled from.
ENDGAME_IMAGE_NAMESPACE=frostaura
# The group that owns /var/run/docker.sock as Dock sees it. 0 on Docker Desktop (the Mac mini);
# on a Linux host, `stat -c %g /var/run/docker.sock`.
DOCKER_SOCKET_GID=0

# THE TUNNEL — pick one.
# (a) A tunnel already running on the host: leave both of these empty and route
#     endgame.<zone> and *.<zone> to http://localhost:<ENDGAME_GATEWAY_PORT>.
# (b) The tunnel inside this stack: COMPOSE_PROFILES=tunnel and the tunnel's token; its public
#     hostnames then route to http://edge:8080.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# OUTGOING MAIL — optional. With no host nothing is sent, and invitations are handed over as links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# OFFSITE BACKUPS — optional, all four or none (Cloudflare R2:
# https://<account id>.r2.cloudflarestorage.com). With none, archives stay on this machine and the
# ops service's health says they are not offsite.
ENDGAME_BACKUP_S3_ENDPOINT=
ENDGAME_BACKUP_S3_BUCKET=
ENDGAME_BACKUP_S3_ACCESS_KEY_ID=
ENDGAME_BACKUP_S3_SECRET_ACCESS_KEY=
ENDGAME_BACKUP_S3_REGION=auto
# A host directory for local archives instead of a volume (writable by uid 1654).
ENDGAME_BACKUP_DIR=
BACKUP_HOUR_UTC=1
ENDGAME_BACKUP_KEEP_DAILY=7
ENDGAME_BACKUP_KEEP_WEEKLY=4
ENDGAME_BACKUP_SCHEDULE=true

# CLOUDFLARE MANAGEMENT — optional, and held: with no token Endgame changes nothing in Cloudflare
# and DNS and tunnel routes are set by hand. With one, changes still happen only on an explicit
# apply (ARCH-007 lists the token's permissions).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=

# TUNING — optional.
# Memory every awake app together may use, in MB.
DOCK_APP_MEMORY_BUDGET_MB=4096
# The private range each app's network is cut from. Change it only if it collides with another.
DOCK_SUBNET_POOL=10.213.0.0/16
ENDGAME_USAGE_REPORT_SECONDS=300
POSTGRES_USER=endgame
POSTGRES_DB=endgame
